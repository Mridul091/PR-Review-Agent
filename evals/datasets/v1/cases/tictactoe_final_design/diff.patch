+class GameState(Enum):
+    IN_PROGRESS = "IN_PROGRESS"
+    WIN = "WIN"
+    DRAW = "DRAW"
+
+
+class Game:
+    def __init__(self, board: Board, player_list: list[Player], strategy: WinningStrategy) -> None:
+        if len(player_list) < 2:
+            raise ValueError("At least 2 players are required")
+        if len({p.symbol for p in player_list}) != len(player_list):
+            raise ValueError("Players must have distinct symbols")
+        self._board = board
+        self._players: deque[Player] = deque(player_list)
+        self._strategy = strategy
+        self._state: GameState = GameState.IN_PROGRESS
+        self._winner: Player | None = None
+        self._history: list[Move] = []
+
+    def move(self, row: int, col: int) -> GameState:
+        if self._state != GameState.IN_PROGRESS:
+            raise GameOverError("Game is already over")
+
+        current_player = self._players[0]
+        self._board.place(row, col, current_player.symbol)
+
+        if self._strategy.record_move(row, col, current_player.symbol):
+            self._state = GameState.WIN
+            self._winner = current_player
+
+        elif self._board.is_full():
+            self._state = GameState.DRAW
+        else:
+            self._players.rotate(-1)
+        self._history.append(Move(row, col, current_player))
+        return self._state
+
+    def undo_move(self):
+        if not self._history:
+            raise NothingToUndoError
+
+        move = self._history.pop()
+        self._board.clear(move.row, move.col)
+        self._strategy.undo_move(move.row, move.col, move.player.symbol)
+        while self._players[0]!= move.player:
+            self._players.rotate(1)
+        self._state = GameState.IN_PROGRESS
+        self._winner = None
+
+
+    @property
+    def current_player(self) -> Player:
+        return self._players[0]
+
+    @property
+    def board(self) -> Board:
+        return self._board
+
+    @property
+    def state(self) -> GameState:
+        return self._state
+
+    @property
+    def winner(self) -> Player | None:
+        return self._winner
+
+
+class GameView(ABC):
+    @abstractmethod
+    def show_board(self, board: Board) -> None: ...
+
+    @abstractmethod
+    def ask_move(self, player: Player) -> tuple[int, int]: ...
+
+    @abstractmethod
+    def show_error(self, message: str) -> None: ...
+
+    @abstractmethod
+    def show_result(self, state: GameState, winner: Player | None) -> None: ...
+
+
+class ConsoleView(GameView):
+    def show_board(self, board: Board) -> None:
+        for r in range(board.size):
+            print(" | ".join(str(board.get_symbol(r, c) or " ") for c in range(board.size)))
+            if r < board.size - 1:
+                print("-" * (board.size * 4 - 3))
+
+    def ask_move(self, player: Player) -> tuple[int, int]:
+        while True:
+            raw = input(f"{player.name} ({player.symbol}), enter row col: ")
+            try:
+                r, c = map(int, raw.split())
+                return r, c
+            except ValueError:
+                print("Please input two numbers, e.g. '1 2'")
+
+    def show_error(self, message: str) -> None:
+        print(f"✗ {message}")
+
+    def show_result(self, state: GameState, winner: Player | None) -> None:
+        if winner is not None:
+            print(f"{winner.name} wins!")
+        else:
+            print("It's a draw.")
+
+
+class GameController:
+    def __init__(self, game: Game, game_view: GameView) -> None:
+        self._game = game
+        self._view = game_view
+
+    def run(self) -> None:
+        while self._game.state == GameState.IN_PROGRESS:
+            self._view.show_board(self._game.board)
+            r, c = self._view.ask_move(self._game.current_player)
+            try:
+                self._game.move(r, c)
+            except InvalidMoveError as e:
+                self._view.show_error(str(e))
+
+        self._view.show_board(self._game.board)
+        self._view.show_result(self._game.state, self._game.winner)
+
+
+def main() -> None:
+    size = 3
+    players = [Player("Mridul", Symbol("X")), Player("Riddhi", Symbol("O"))]
+    game = Game(Board(size), players, RowColDiagonalStrategy(size))
+    GameController(game, ConsoleView()).run()
