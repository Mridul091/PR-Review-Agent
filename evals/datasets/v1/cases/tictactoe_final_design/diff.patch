+class WinningStrategy(ABC):
+
+    @abstractmethod
+    def record_move(self, r: int, c: int, s: Symbol) -> bool:
+        ...
+
+    @abstractmethod
+    def undo_move(self, r: int, c: int, s: Symbol) -> None:
+        ...
+
+
+class RowColDiagonalStrategy(WinningStrategy):
+
+    def __init__(self, size: int) -> None:
+        self._size = size
+        self._row_counts: dict[Symbol, list[int]] = defaultdict(lambda: [0] * size)
+        self._col_counts: dict[Symbol, list[int]] = defaultdict(lambda: [0] * size)
+        self._diag_count: dict[Symbol, int] = defaultdict(int)
+        self._anti_diag_count: dict[Symbol, int] = defaultdict(int)
+
+    def _apply(self, r: int, c: int, s: Symbol, delta: int) -> None:
+        self._row_counts[s][r] += delta
+        self._col_counts[s][c] += delta
+        if r == c:
+            self._diag_count[s] += delta
+        if r + c == self._size - 1:
+            self._anti_diag_count[s] += delta
+
+    def record_move(self, r: int, c: int, s: Symbol) -> bool:
+        self._apply(r, c, s, +1)
+        n = self._size
+        return (self._row_counts[s][r] == n
+                or self._col_counts[s][c] == n
+                or self._diag_count[s] == n
+                or self._anti_diag_count[s] == n)
+
+    def undo_move(self, r: int, c: int, s: Symbol) -> None:
+        self._apply(r, c, s, -1)
+
