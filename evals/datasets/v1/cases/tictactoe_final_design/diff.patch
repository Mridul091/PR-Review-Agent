+    # ---- commands ----
+    def place(self, r: int, c: int, symbol: Symbol) -> None:
+        """Place a symbol; raise OutOfBoundsError / CellOccupiedError if illegal."""
+        self._check_bounds(r, c)
+        if self._grid[r][c] is not None:
+            raise CellOccupiedError(f"({r}, {c}) is already occupied")
+        self._grid[r][c] = symbol
+        self._filled_cells += 1
+
+    def clear(self, r: int, c: int) -> None:
+        """Reverse a placement; raise InvalidMoveError if the cell is already empty."""
+        self._check_bounds(r, c)
+        if self._grid[r][c] is None:
+            raise InvalidMoveError(f"({r}, {c}) is already empty")
+        self._grid[r][c] = None
+        self._filled_cells -= 1
