+@router.get("/files/{filename:path}")
+def download(filename: str) -> FileResponse:
+    full_path = os.path.join(UPLOAD_DIR, filename)
+    if not os.path.exists(full_path):
+        raise HTTPException(status_code=404, detail="File not found")
