# ─────────────────────────────────────────────
#  Server Configuration
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
REVIEW_API_TOKEN=local-development-secret
# JSON map of GitHub App installation IDs to repositories accessible to this token.
# Empty/missing means no review API access; match both installation and target repository.
REVIEW_REPOSITORY_ACCESS='{"1234":["owner/repo"]}'

# ─────────────────────────────────────────────
#  GitHub App Integration
#  → Register at: https://github.com/settings/apps/new
# ─────────────────────────────────────────────
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY_PATH=./github_private_key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Input safety limits
MAX_PR_FILES=300
MAX_DIFF_BYTES=1000000
MAX_REVIEW_CONTEXT_CHARS=20000
MAX_MODEL_ATTEMPTS=2
MAX_PATCH_BYTES=250000
MAX_WEBHOOK_BYTES=1000000
GITHUB_REQUEST_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────
#  LLM Configuration
#  Use "fake" for local smoke tests, or "groq" for real model calls.
# ─────────────────────────────────────────────
LLM_PROVIDER=fake
LLM_MODEL=llama-3.3-70b-versatile
# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────
#  RAG & Vector Database (Phase 5)
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─────────────────────────────────────────────
#  Relational Database
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./pr_reviewer.db
